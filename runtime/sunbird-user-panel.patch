+/// Windows' account mute/deafen renderer, shared by the two split controls.
+/// Its sixth argument selects deafen; the false branch is the microphone.
+/// Fail closed when the frame/argument layout changes.
+pub fn user_panel_controls(image: &Image<'_>) -> Found<usize> {
+   if Abi::of(image) != Abi::Win64 {
+      return Err("user panel buttons currently require Win64".to_owned());
+   }
+   let funcs = string_leas(image, &[b"user-panel-mute", b"user-panel-deafen"]);
+   let funcs: HashSet<_> = funcs
+      .into_values()
+      .flatten()
+      .filter_map(|site| image.function_bounds(site).map(|(start, _)| start))
+      .collect();
+   let candidates: Vec<_> = funcs
+      .into_iter()
+      .filter(|&func| prologues(image).frame.at(image, func))
+      .collect();
+   let func = one("account mute/deafen renderer", &candidates)?;
+   let code = function_code(image, func, "account controls")?;
+   // This ABI is explicitly validated, rather than applying a hook to an unknown frame.
+   if !code.starts_with(&[
+      0x55, 0x41, 0x57, 0x41, 0x56, 0x41, 0x55, 0x41, 0x54, 0x56, 0x57, 0x53, 0x48, 0x81, 0xEC,
+      0x28, 0x0F, 0, 0,
+   ]) || !code
+      .windows(7)
+      .any(|w| w == [0x80, 0xBD, 0x18, 0x0F, 0, 0, 0])
+   {
+      return Err("account control argument layout changed".to_owned());
+   }
+   Ok(func)
+}
