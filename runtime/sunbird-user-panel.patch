+//! Plugin controls immediately before the native microphone split button.
+use crate::{
+   accessories,
+   gpui::{self, BtnSize, BtnVariant, RawAnyElement, RcFnVtbl},
+};
+use phoenix_hook::{image::Image, x86::Abi};
+use phoenix_sigs::desktop;
+use std::{
+   ffi::c_void,
+   ptr,
+   sync::{LazyLock, Mutex, OnceLock, PoisonError, mpsc},
+};
+
+#[derive(Clone)]
+pub struct Button {
+   pub id: u64,
+   pub glyph: String,
+   pub active: bool,
+   pub busy: bool,
+}
+static BUTTONS: LazyLock<Mutex<Vec<Button>>> = LazyLock::new(|| Mutex::new(Vec::new()));
+static ORIG: OnceLock<Render> = OnceLock::new();
+static CLICK: OnceLock<mpsc::Sender<u64>> = OnceLock::new();
+type Render = unsafe extern "C" fn(
+   *mut RawAnyElement,
+   usize,
+   usize,
+   usize,
+   usize,
+   usize,
+   usize,
+   usize,
+   usize,
+   usize,
+   usize,
+   usize,
+   usize,
+   usize,
+   usize,
+) -> *mut RawAnyElement;
+
+pub fn available() -> bool {
+   ORIG.get().is_some()
+}
+
+pub fn sync(buttons: Vec<Button>) {
+   *BUTTONS.lock().unwrap_or_else(PoisonError::into_inner) = buttons;
+   CLICK.get_or_init(|| {
+      let (tx, rx) = mpsc::channel();
+      let _ = std::thread::Builder::new()
+         .name("sunbird-panel".into())
+         .spawn(move || {
+            while let Ok(id) = rx.recv() {
+               if let Some(engine) = phoenix_runtime::engine() {
+                  crate::js::ui::invoke_panel_button(&engine, id);
+               }
+            }
+         });
+      tx
+   });
+   accessories::invalidate_discord_windows();
+}
+
+static CALLBACK: RcFnVtbl = RcFnVtbl {
+   drop_in_place: ptr::null(),
+   size: size_of::<u64>(),
+   align: align_of::<u64>(),
+   call_once: click as *const c_void,
+   call_mut: click as *const c_void,
+   call: click as *const c_void,
+   extra: ptr::null(),
+};
+
+unsafe extern "C" fn click(id: *const u64, _event: usize, _window: usize, _app: usize) {
+   if id.is_null() {
+      return;
+   }
+   // SAFETY: GPUI passes the Rc payload allocated by build_raw_button.
+   let id = unsafe { *id };
+   let allowed = BUTTONS
+      .lock()
+      .unwrap_or_else(PoisonError::into_inner)
+      .iter()
+      .any(|button| button.id == id && !button.busy);
+   if allowed && let Some(tx) = CLICK.get() {
+      let _ = tx.send(id);
+   }
+}
+
+pub fn install(image: &Image<'static>) {
+   if !gpui::supports_push_any() {
+      return;
+   }
+   let func = match desktop::user_panel_controls(image) {
+      Ok(func) => func,
+      Err(err) => {
+         log::warn!("desktop user panel: {err}");
+         return;
+      },
+   };
+   let pro = desktop::Prologues::of(Abi::of(image)).frame;
+   // SAFETY: the locator validates the Win64 renderer's stack/argument layout.
+   match unsafe { image.hook_entry(func, pro.pattern, pro.len, render as *const () as usize) } {
+      Ok(trampoline) => {
+         // SAFETY: this trampoline has the verified renderer signature.
+         let _ = ORIG.set(unsafe { std::mem::transmute::<usize, Render>(trampoline) });
+         log::info!("desktop user panel: hooked controls @ {func:#x}");
+      },
+      Err(err) => log::warn!("desktop user panel: {err}"),
+   }
+}
+
+#[allow(clippy::too_many_arguments)]
+unsafe extern "C" fn render(
+   sret: *mut RawAnyElement,
+   a2: usize,
+   a3: usize,
+   a4: usize,
+   a5: usize,
+   deafen: usize,
+   a7: usize,
+   a8: usize,
+   a9: usize,
+   a10: usize,
+   a11: usize,
+   a12: usize,
+   a13: usize,
+   a14: usize,
+   a15: usize,
+) -> *mut RawAnyElement {
+   let Some(orig) = ORIG.get() else {
+      return sret;
+   };
+   // SAFETY: forward every original argument; the first four are register arguments.
+   let out = unsafe {
+      orig(
+         sret, a2, a3, a4, a5, deafen, a7, a8, a9, a10, a11, a12, a13, a14, a15,
+      )
+   };
+   if deafen & 255 != 0 || sret.is_null() {
+      return out;
+   }
+   let buttons = BUTTONS
+      .lock()
+      .unwrap_or_else(PoisonError::into_inner)
+      .clone();
+   if buttons.is_empty() {
+      return out;
+   }
+   let _ = std::panic::catch_unwind(|| {
+      let Some(mut row) = gpui::h_row(2.0, false) else {
+         return;
+      };
+      for button in buttons {
+         let variant = if button.active {
+            BtnVariant::Secondary
+         } else {
+            BtnVariant::Critical
+         };
+         let text = if button.busy { "…" } else { &button.glyph };
+         if let Some(btn) = gpui::build_raw_button(
+            &format!("sunbird-panel-{}", button.id),
+            text,
+            variant,
+            BtnSize::Small,
+            &raw const CALLBACK,
+            button.id,
+         ) {
+            row = gpui::push_raw_button(row, btn);
+         }
+      }
+      // SAFETY: take the returned AnyElement exactly once and move it into its new parent.
+      let mut original = unsafe { ptr::read(sret) };
+      if gpui::push_any(&mut row, &mut original) {
+         gpui::write_any(row, sret);
+      } else {
+         unsafe { ptr::write(sret, original) };
+      }
+   });
+   out
+}
